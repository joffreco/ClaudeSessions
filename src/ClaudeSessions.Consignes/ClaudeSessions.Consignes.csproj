<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>ClaudeSessions.Consignes</RootNamespace>
    <AssemblyName>Consignes</AssemblyName>
    <ApplicationIcon>Assets/Consignes.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/Consignes.ico" />
    <ProjectReference Include="../ClaudeSessions.Core/ClaudeSessions.Core.csproj" />
    <ProjectReference Include="../ClaudeSessions.Adapters/ClaudeSessions.Adapters.csproj" />
  </ItemGroup>
</Project>
