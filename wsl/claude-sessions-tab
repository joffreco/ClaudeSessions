#!/bin/bash
# Start the Claude Code session of one claude-sessions tab (run by the Windows app through wsl.exe).
# Resumes the session when a transcript of it exists, else creates it under the same id.
# Exports CLAUDE_SESSIONS_TAB and CLAUDE_SESSIONS_TAB_PID for the session-registry hook; both execs
# keep this PID, so claude itself runs with PID $CLAUDE_SESSIONS_TAB_PID.
# Usage: claude-sessions-tab <tab_uuid> <session_uuid>
uuid='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'

if [ "$#" -ne 2 ] || [[ ! "$1" =~ $uuid ]] || [[ ! "$2" =~ $uuid ]]; then
  echo "usage: claude-sessions-tab <tab_uuid> <session_uuid>" >&2
  exit 2
fi
session="$2"
export CLAUDE_SESSIONS_TAB="$1"
export CLAUDE_SESSIONS_TAB_PID=$$

shopt -s nullglob
transcripts=("$HOME"/.claude/projects/*/"$session".jsonl)
if [ "${#transcripts[@]}" -gt 0 ]; then
  exec bash -lic 'exec claude --resume "$1"' _ "$session"
fi
exec bash -lic 'exec claude --session-id "$1"' _ "$session"
