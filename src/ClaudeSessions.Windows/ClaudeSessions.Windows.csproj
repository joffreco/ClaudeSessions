<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>ClaudeSessions.Windows</RootNamespace>
    <AssemblyName>ClaudeSessions</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ClaudeSessions.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ClaudeSessions.ico" />
    <ProjectReference Include="../ClaudeSessions.Core/ClaudeSessions.Core.csproj" />
    <ProjectReference Include="../ClaudeSessions.Adapters/ClaudeSessions.Adapters.csproj" />
    <ProjectReference Include="../ClaudeSessions.Terminal/ClaudeSessions.Terminal.csproj" />
  </ItemGroup>
</Project>
